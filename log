local function scanGarbageForInventory()
    local bestInv, maxItems = nil, -1
    for _, v in ipairs(getgc(true)) do
        if type(v) == "table" and rawget(v, "melee") and rawget(v, "misc") then
            local itemCount = 0
            for catName, catData in pairs(v) do
                if type(catData) == "table" and AllowedCategories[catName] then
                    for _, itemsArr in pairs(catData) do
                        if type(itemsArr) == "table" then
                            for _, item in ipairs(itemsArr) do
                                if type(item) == "table" and rawget(item, "guid") then itemCount = itemCount + 1 end
                            end
                        end
                    end
                end
            end
            if itemCount > maxItems then maxItems = itemCount; bestInv = v end
        end
    end
    return bestInv
