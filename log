-- ระบบประมวลผลกระเป๋า (เพิ่มตัวหน่วงเวลา 3 รอบเมื่อของเป็น 0)
-- ==========================================
local LastValidInventory = nil
local EmptyReadCount = 0
local MAX_EMPTY_READS = 3 -- จำนวนรอบที่ต้องเป็น 0 ติดต่อกันถึงจะยืนยันว่าของหมดจริง

local function _G_Inventory()
    local invCounts = { ["MP5"] = 0, ["Remington"] = 0, ["AK47"] = 0, ["M16"] = 0, ["RPG"] = 0, ["Anaconda"] = 0, ["Energy Shot"] = 0, ["Energy shot"] = 0, ["Rocket"] = 0, ["rocket"] = 0 }
    
    local currentInv = cachedInventory or scanGarbageForInventory()
    
    if not currentInv then
        if LastValidInventory then
            EmptyReadCount = EmptyReadCount + 1
            if EmptyReadCount >= MAX_EMPTY_READS then
                LastValidInventory = { MP5 = 0, Remington = 0, AK47 = 0, M16 = 0, RPG = 0, Anaconda = 0, EnergyShot = 0, Rocket = 0 }
            end
            return LastValidInventory
        end
        return { MP5 = 0, Remington = 0, AK47 = 0, M16 = 0, RPG = 0, Anaconda = 0, EnergyShot = 0, Rocket = 0 }
    end
    
    local seenGuids = {} 
    
    for category, categoryItems in pairs(currentInv) do
        if type(categoryItems) == "table" and AllowedCategories[category] then
            for itemName, itemInstances in pairs(categoryItems) do
                if invCounts[itemName] ~= nil then
                    if type(itemInstances) == "table" then
                        for _, itemData in ipairs(itemInstances) do
                            if type(itemData) == "table" then
                                local guid = rawget(itemData, "guid")
                                local amount = rawget(itemData, "amount") or 1
                                if guid then
                                    if amount > 0 and not seenGuids[guid] then
                                        seenGuids[guid] = true
                                        invCounts[itemName] = invCounts[itemName] + amount
                                    end
                                else
                                    if amount > 0 then invCounts[itemName] = invCounts[itemName] + amount end
                                end
                            end
                        end
                    elseif type(itemInstances) == "number" and itemInstances > 0 then
                        invCounts[itemName] = math.max(invCounts[itemName], itemInstances)
                    end
                end
            end
        end
    end
    
    local result = {
        MP5 = invCounts["MP5"], Remington = invCounts["Remington"], AK47 = invCounts["AK47"], M16 = invCounts["M16"], RPG = invCounts["RPG"], Anaconda = invCounts["Anaconda"], EnergyShot = (invCounts["Energy Shot"] or 0) + (invCounts["Energy shot"] or 0), Rocket = (invCounts["Rocket"] or 0) + (invCounts["rocket"] or 0)
    }
    
    local totalItems = 0
    for _, amount in pairs(result) do
        totalItems = totalItems + amount
    end
    
    if totalItems > 0 then
        LastValidInventory = result
        EmptyReadCount = 0 
    else
        if not LastValidInventory then
            LastValidInventory = result 
        else
            EmptyReadCount = EmptyReadCount + 1
            if EmptyReadCount >= MAX_EMPTY_READS then
                LastValidInventory = result
            end
        end
    end
    
    return LastValidInventory
end

