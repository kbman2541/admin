local hoverHeight = 3
local maxClimbHeight = 4
local lookAheadDistance = 3

local function calculateHoverY(myCharacter, currentRootPos, directionUnit)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {myCharacter}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    local forwardRay = Workspace:Raycast(currentRootPos, directionUnit * lookAheadDistance, rayParams)
    local checkAheadPos = currentRootPos + (directionUnit * lookAheadDistance)
    if forwardRay then checkAheadPos = forwardRay.Position + (directionUnit * 0.1) end

    local rayOrigin = Vector3.new(checkAheadPos.X, currentRootPos.Y + maxClimbHeight, checkAheadPos.Z)
    
    -- แก้ไขระยะ Raycast ให้ยิงลึกลงไป 5000 Studs เพื่อให้หาพื้นเจอเสมอเวลาลงจากที่สูง
    local rayDirection = Vector3.new(0, -5000, 0) 
    
    local rayResult = Workspace:Raycast(rayOrigin, rayDirection, rayParams)
    
    local targetY = currentRootPos.Y
    if rayResult then targetY = rayResult.Position.Y + hoverHeight end
    
    return targetY
end

function Sf:Teleport(destination, stopIfOutdoors)
    c().StopWalking = false
    c()['Running'] = true
    local char = Client.Character or Client.CharacterAdded:Wait()
    local RootPart = char:WaitForChild("HumanoidRootPart")
    local Humanoid = char:WaitForChild("Humanoid")
    
    local path = PathfindingService:CreatePath({
        AgentCanJump = true, AgentRadius = 2.8, AgentHeight = 5.0, WaypointSpacing = 3,
        Costs = { BlockedNode = 50, DoorArea = 1 }
    })
    
    local success = pcall(function() path:ComputeAsync(RootPart.Position, destination) end)
    if not success or path.Status ~= Enum.PathStatus.Success then c()['Running'] = false return end
    
    local waypoints = path:GetWaypoints()
    table.insert(waypoints, PathWaypoint.new(destination, Enum.PathWaypointAction.Walk))
    
    local currentBaseY = RootPart.Position.Y
    for _, wp in pairs(waypoints) do
        local targetPos = wp.Position
        
        while not c().StopWalking and Config.IsNavigating do
            local dt = RunService.Heartbeat:Wait()
            c()['Running'] = true
            
            if not Config.IsNavigating or Humanoid.Health <= 0 then break end
            
            if stopIfOutdoors and not isIndoors(RootPart.Position) then
                c()['Running'] = false
                return true
            end
            
            if CheckAntiCheatUI() then
                print("⚠️ ตรวจพบ Anti-Cheat ขณะเดินเท้า -> ยกเลิกและคำนวณใหม่")
                c()['Running'] = false
                return "Restart"
            end
            
            if Humanoid.Sit then ForceUnmountVehicle() end
            
            local currentPos = RootPart.Position
            local dist2D = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(currentPos.X, 0, currentPos.Z)).Magnitude
            
            if dist2D <= 3.5 then break end
            
            local direction = (Vector3.new(targetPos.X, currentBaseY, targetPos.Z) - Vector3.new(currentPos.X, currentBaseY, currentPos.Z))
            
            if direction.Magnitude > 0.01 then
                local moveStep = math.min(Config.InstantTeleportSpeed * dt, direction.Magnitude)
                currentBaseY = calculateHoverY(char, currentPos, direction.Unit)
                
                local newPos = Vector3.new(currentPos.X + (direction.Unit * moveStep).X, currentBaseY, currentPos.Z + (direction.Unit * moveStep).Z)
                RootPart.CFrame = CFrame.lookAt(newPos, newPos + direction.Unit)
                
                RootPart.AssemblyLinearVelocity = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero
            end
            Sf:Ac("set_sprinting_1", true)
        end
        if not Config.IsNavigating or c().StopWalking then break end
    end
    c()['Running'] = false
end

-- STREAMING_CHUNK:Refined Vehicle Navigation Logic (Stable Drive)...
function Sf:Drive(model, destination, stopCarDist)
    stopCarDist = stopCarDist or 0
    if not model or not model.PrimaryPart then c()['Running'] = false return false end
    c()["StopWalking"] = false
    
    local isCar = c().VechineType == "car"
    local path = PathfindingService:CreatePath({
        AgentRadius = isCar and 5.5 or 2,
        AgentHeight = isCar and 6 or 5,
        AgentCanJump = true, WaypointSpacing = 8,
        Costs = { BlockedNode = 100, Cars = 1, Water = math.huge, DoorArea = 1 }
    })
    
    local success = pcall(function() path:ComputeAsync(model.PrimaryPart.Position, destination) end)
    
    if not success or path.Status ~= Enum.PathStatus.Success then
          c()['Running'] = false
          if Humanoid.Sit then ForceUnmountVehicle() end
        return false 
    end
    
    local waypoints = path:GetWaypoints()
    table.insert(waypoints, PathWaypoint.new(destination, Enum.PathWaypointAction.Walk))
    
    for i, wp in pairs(waypoints) do
        if not model or not model.PrimaryPart then c()['Running'] = false return false end
        local startPos = model:GetPivot().Position
        local heightOffset = (wp.Action == Enum.PathWaypointAction.Jump) and 8 or (isCar and 3.5 or 2)
        local goalPos = wp.Position + Vector3.new(0, heightOffset, 0)
        local dir = (goalPos - startPos).Unit
        local dist = (goalPos - startPos).Magnitude
        local movedDist = 0
        local speed = Config.InstantVechineSpeed or 52
        
        while movedDist < dist and Config.IsNavigating and not c().StopWalking do
            local dt = RunService.Heartbeat:Wait()
            if not model or not model.PrimaryPart then c()['Running'] = false return false end
            c()['Running'] = true
            if not Config.IsNavigating then c()['Running'] = false return false end
            
            if stopCarDist > 0 and (model:GetPivot().Position - destination).Magnitude <= stopCarDist then
                c()['Running'] = false
                return true
            end
            
            if CheckAntiCheatUI() then
                print("⚠️ ตรวจพบ Anti-Cheat ขณะขับรถ -> กดยกเลิกการทำงานและเริ่มเดินทางใหม่ (Restart)")
                if Humanoid and Humanoid.Sit then ForceUnmountVehicle() end
                c()['Running'] = false
                return "Restart"
            end
            
            if not Humanoid.Sit then 
                ForceMountVehicle(model)
                if not Humanoid.Sit then
                    c()['Running'] = false 
                    return false 
                end
            end
            
            movedDist = math.min(movedDist + (dt * speed), dist)
            local newPos = startPos + dir * movedDist
            
            local flatDir = Vector3.new(dir.X, 0, dir.Z)
            if flatDir.Magnitude > 0.001 then
                flatDir = flatDir.Unit
            else
                local lookV = model:GetPivot().LookVector 
                flatDir = Vector3.new(lookV.X, 0, lookV.Z)
                if flatDir.Magnitude > 0.001 then
                    flatDir = flatDir.Unit
                else
                    flatDir = Vector3.new(1, 0, 0)
                end
            end
            
            local lookAtPos = newPos + flatDir
            model:PivotTo(CFrame.lookAt(newPos, lookAtPos))
            
            for _, part in ipairs(model:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
        c()['Running'] = false
        if not Config.IsNavigating then return false end
    end
    c()['Running'] = false
    return true
end

