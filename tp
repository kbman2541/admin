local function distTo(v3)
    if not RootPart then return math.huge end
    return (v3 - RootPart.Position).Magnitude
end

local function GetAllATM()
    local all = {}
    local ATMsFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Props") and workspace.Map.Props:FindFirstChild("ATMs")
    if ATMsFolder then
        for _, atm in pairs(ATMsFolder:GetChildren()) do
            if atm.Name == "ATM" and atm:IsA("Model") then table.insert(all, atm) end
        end
    end
    return all
end

local function GetDepositATMPos()
    local shortestDist, atmPos = math.huge, nil
    for _, atm in ipairs(GetAllATM()) do
        local pos = atm.PrimaryPart and atm.PrimaryPart.Position
        if not pos then
            for _, part in ipairs(atm:GetDescendants()) do
                if part:IsA("BasePart") then pos = part.Position break end
            end
        end
        if pos then
            local d = distTo(pos)
            if d < shortestDist then shortestDist = d; atmPos = pos end
        end
    end
    return atmPos
end

