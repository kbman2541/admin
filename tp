                        Drowning = v:FindFirstChild('DestroyedItemIcon') and v.DestroyedItemIcon.Visible
                    end
                end
            end
        end
    end
    return amount, IsHaving, Uid, Using, Drowning
end

local function isIndoors(pos)
    local params = RaycastParams.new()
    local ignoreList = workspace:FindFirstChild("Vehicles") and workspace.Vehicles:GetChildren() or {}
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then table.insert(ignoreList, p.Character) end
    end
    params.FilterDescendantsInstances = ignoreList
    params.FilterType = Enum.RaycastFilterType.Exclude
    
    local hit = workspace:Raycast(pos, Vector3.new(0, 50, 0), params)
    return hit ~= nil
end

