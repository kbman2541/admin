local function ForceMountVehicle(vehicle)
    if not vehicle or not vehicle.PrimaryPart then return false end
    local attempts = 0
    
    while not Humanoid.Sit and attempts < 10 and Config.IsNavigating do
        attempts = attempts + 1
        local charLook = RootPart.CFrame.LookVector
        local spawnPos = RootPart.Position - (charLook * 4) + Vector3.new(0, 3, 0)
        local vehicleRotation = CFrame.new(spawnPos) * CFrame.Angles(0, math.atan2(charLook.X, charLook.Z), 0)
        
        for _, part in ipairs(vehicle:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
        
        vehicle:PivotTo(vehicleRotation)
        task.wait(0.1)
        
        for _, prompt in pairs(vehicle:GetDescendants()) do
            if prompt:IsA('ProximityPrompt') then
                fireproximityprompt(prompt)
            end
        end
        
        local w = 0
        while not Humanoid.Sit and w < 10 and Config.IsNavigating do
            task.wait(0.1)
            w = w + 1
        end
    end
    return Humanoid.Sit
end

local function ForceUnmountVehicle()
    if not Humanoid or not RootPart then return end
    Net.get("exit_seat")
    Humanoid.Sit = false
    
    local waitExit = 0
    while Humanoid.Sit and waitExit < 15 and Config.IsNavigating do
        task.wait(0.1)
        waitExit = waitExit + 1
        Humanoid.Sit = false
    end
    
    if RootPart then
        local rightVector = RootPart.CFrame.RightVector
        local jumpOffPos = RootPart.Position + (rightVector * 6) + Vector3.new(0, 2, 0)
        RootPart:PivotTo(CFrame.new(jumpOffPos))
        RootPart.AssemblyLinearVelocity = Vector3.zero
        RootPart.AssemblyAngularVelocity = Vector3.zero
    end
    task.wait(0.3)
end

