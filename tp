btnSafe.MouseButton1Click:Connect(function()
    local safePos = nil
    local minDistance = math.huge
    local searchArea = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Tiles") or workspace
    for _, descendant in ipairs(searchArea:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant.Name == "TouchPart" and descendant.Parent and descendant.Parent.Name == "SafeBeacon" then
            local dist = distTo(descendant.Position)
            if dist < minDistance then
                minDistance = dist
                safePos = descendant.Position
            end
        end
