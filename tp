local function FindVehicleForNav()
    local ScrollingFrame = PlayerGui:FindFirstChild("Items") and PlayerGui.Items:FindFirstChild("ItemsHolder") and PlayerGui.Items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
    if not ScrollingFrame then return nil, nil end
    
    for _, v in ipairs(ScrollingFrame:GetChildren()) do
        if v:GetAttribute("ItemType") == "bike" then
            return (v.ItemName.Text == "BMX" and "BMX" or v.ItemName.Text), "bike"
        end
    end
    for _, v in ipairs(ScrollingFrame:GetChildren()) do
        if v:GetAttribute('ItemType') == "car" then return v.ItemName.Text, "car" end
    end
    return nil, nil
end

-- STREAMING_CHUNK:Handling Main Navigation Processing...
local currentNavID = 0
local function StartNavTo(shopData, targetName)
    Sf:ForceStop()
    task.wait(0.1) 
    currentNavID = currentNavID + 1
    local myNavID = currentNavID
    
    Config.IsNavigating = true
    btnStop.BackgroundColor3 = Color3.fromRGB(220, 20, 60)
    btnStop.Text = "⏹️ กำลังไป " .. (targetName or "เป้าหมาย") .. " [R]"
    
    task.spawn(function()
        local char = Client.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        local myVehicle = nil
        for _, vehicle in ipairs(workspace.Vehicles:GetChildren()) do
            if vehicle:GetAttribute('OwnerUserId') == UserId then
                myVehicle = vehicle
                break
            end
        end
        
        local vehicleName, vehicleType = FindVehicleForNav()
        if vehicleType then Config.VechineType = vehicleType end
        
        if not myVehicle and vehicleName then
            local amount, isHaving, uid, using, drowning = Sf:GetInfo(vehicleName)
            if isHaving and not using and not drowning then
                Net.get("toggle_equip_item", tostring(uid))
                task.wait(0.5)
            end
            
            local wc = 0
            repeat
                task.wait(0.2)
                wc = wc + 1
                for _, v in ipairs(workspace.Vehicles:GetChildren()) do
                    if v:GetAttribute('OwnerUserId') == UserId then
                        myVehicle = v
                        break
                    end
                end
            until myVehicle or wc > 15
        end
        
        if myVehicle and not vehicleType then
            local mName = string.lower(myVehicle.Name)
            if mName:match("bmx") or mName:match("bike") or mName:match("motor") or mName:match("scooter") then
                Config.VechineType = "bike"
            else
                Config.VechineType = "car"
            end
        end
        
        if myNavID ~= currentNavID or not Config.IsNavigating then return end
        
        if root and isIndoors(root.Position) then
            print("📍 คุณอยู่ในบ้าน/ในร่ม กำลังเดินออกไปข้างนอกก่อนเรียกรถ...")
            if Humanoid.Sit then ForceUnmountVehicle() end
            
            local nearestExit = nil
            local minDist = 150
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") and (v.Name:lower():match("door") or v.Name == "TouchPart") then
                    if v.Parent and v.Parent.Name == "SafeBeacon" then continue end
                    if not v:IsDescendantOf(char) then
                        local d = (v.Position - root.Position).Magnitude
                        if d < minDist then
                            minDist = d
                            nearestExit = v.Position
                        end
                    end
                end
            end
            
            if nearestExit then
                if Sf:Teleport(nearestExit, true) == "Restart" then
                    StartNavTo(shopData, targetName)
                    return
                end
            else
                if Sf:Teleport(shopData.P1, true) == "Restart" then
                    StartNavTo(shopData, targetName)
                    return
                end
            end
            task.wait(0.5)
        end
        
        if root then
            for shopName, data in pairs(shops) do
                if data.P1 then
                    local dist = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(data.P1.X, 0, data.P1.Z)).Magnitude
                    if dist <= 25 and shopData.P1 ~= data.P1 then
                        if Humanoid.Sit then ForceUnmountVehicle() end
                        if Sf:Teleport(data.P1) == "Restart" then
                            StartNavTo(shopData, targetName)
                            return
                        end
                        task.wait(0.2)
                        break
                    end
                end
            end
        end
        
        if myNavID ~= currentNavID or not Config.IsNavigating then return end
        
        if myVehicle and Config.IsNavigating then
            Sf:Ac("lock_vehicle", myVehicle, true)
            ForceMountVehicle(myVehicle)
        end
        
        if myNavID ~= currentNavID or not Config.IsNavigating then return end
        
        if Config.IsNavigating then
            if myVehicle and Humanoid.Sit then
                local driveSuccess = Sf:Drive(myVehicle, shopData.P1, shopData.StopCarDist or 15)
                
                if myNavID ~= currentNavID or not Config.IsNavigating then return end
                
                if driveSuccess == "Restart" then
                    print("🔄 ขับรถชน Anti-Cheat กำลังรันคำสั่งเดินทางใหม่อีกครั้ง...")
                    StartNavTo(shopData, targetName)
                    return
                end
                
                if driveSuccess == false then
                    if Sf:Teleport(shopData.P1) == "Restart" then
                        StartNavTo(shopData, targetName)
                        return
                    end
                end
                
                if Config.IsNavigating and shopData.P2 then
                    print("📍 จอดรถแล้ว! กำลังเดินเท้าเข้าไป...")
                    ForceUnmountVehicle()
                    if myNavID ~= currentNavID or not Config.IsNavigating then return end
                    
                    if Sf:Teleport(shopData.P2) == "Restart" then
                        StartNavTo(shopData, targetName)
                        return
                    end
                end
            else
                if Sf:Teleport(shopData.P1) == "Restart" then
                    StartNavTo(shopData, targetName)
                    return
                end
                
                if myNavID == currentNavID and Config.IsNavigating and shopData.P2 then
                    if Sf:Teleport(shopData.P2) == "Restart" then
                        StartNavTo(shopData, targetName)
                        return
                    end
                end
            end
            
            if myNavID == currentNavID and Config.IsNavigating then
                print("📍 ถึง " .. (targetName or "เป้าหมาย") .. " แล้ว! (รอการยืนยันตำแหน่ง 2 วินาที)")
                local finalDest = shopData.P2 or shopData.P1
                local confirmTime = 0
                
                while confirmTime < 2 and myNavID == currentNavID and Config.IsNavigating do
                    task.wait(0.2)
                    confirmTime = confirmTime + 0.2
                    if RootPart then
                        local p1 = Vector3.new(RootPart.Position.X, 0, RootPart.Position.Z)
                        local p2 = Vector3.new(finalDest.X, 0, finalDest.Z)
                        
                        if (p1 - p2).Magnitude > 8 then
                            print("⚠️ ตรวจพบการดึงกลับ! กำลังวาร์ปซ่อมไปที่เป้าหมาย...")
                            if Sf:Teleport(finalDest) == "Restart" then
                                StartNavTo(shopData, targetName)
                                return
                            end
                            confirmTime = 0 
                        end
                    end
                end
                
                if myNavID == currentNavID and Config.IsNavigating then
                    print("✅ ยืนยันตำแหน่งสำเร็จ!")
                    Sf:ForceStop()
                    btnStop.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
                    btnStop.Text = "⏹️ หยุด [R]"
                end
            end
        end
    end)
end

